# Copy this file to cai.env and fill in a real key, then keep cai.env PRIVATE.
# CAI needs at least one LLM provider key. Use OpenAI, Anthropic, or a local
# Ollama endpoint. See https://aliasrobotics.github.io/cai/cai_installation/
OPENAI_API_KEY="sk-replace-with-your-key"
ANTHROPIC_API_KEY=""
# Model CAI should use (see the CAI docs for supported model names), e.g.:
CAI_MODEL="gpt-4o"
# Recommended for container terminals:
PROMPT_TOOLKIT_NO_CPR=1
# Optional: point CAI at a custom/self-hosted or proxy endpoint, or Ollama:
# OPENAI_BASE_URL=""
# OLLAMA=""
